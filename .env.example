# WebSocket хост PartyKit сервера (для продакшена или локального сервера)
# Локально: localhost:1999
# Render: detective-game-haxi.onrender.com
VITE_PARTYKIT_HOST=detective-game-haxi.onrender.com

# (Опционально) IP-адрес хоста в локальной Wi-Fi сети для подключения смартфонов к ТВ-лобби
# Пример: 192.168.1.50:5173
VITE_DEV_LAN_HOST=

