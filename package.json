{
    "name": "detective-game",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "patch:run": "node patcher.cjs && npm run audit:all && npm run dev:all",
        "dev:all": "concurrently \"npm run party:dev\" \"npm run dev\"",
        "party:dev": "partykit dev",
        "dev": "vite --host",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "optimize:assets": "node scripts/optimize-images.mjs",
        "audit:all": "vitest run && tsc --noEmit && vite build",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist"
    },
    "dependencies": {
        "firebase": "^12.19.0",
        "framer-motion": "^11.1.7",
        "partysocket": "^1.3.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "10.4.19",
        "concurrently": "^10.0.6",
        "esbuild": "^0.28.2",
        "gh-pages": "^6.3.0",
        "jsdom": "^29.1.1",
        "partykit": "^0.0.115",
        "postcss": "8.4.38",
        "sharp": "^0.35.5",
        "tailwindcss": "3.4.3",
        "typescript": "^5.4.5",
        "vite": "^5.2.11",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^1.6.0"
    }
}
