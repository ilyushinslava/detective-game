        setGameState((prev) => {
          if (prev.winner) return prev;
          if (prev.mode === "SECRET_SERVICE") {
            return getSecretServiceAIMove(prev);
          }
          if (prev.currentTurn === "KILLER") {
            return getKillerAIMove(prev);
          }
          return getDetectiveAIMove(prev);
        });
        setIsAIThinking(false);
