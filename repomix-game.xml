              className={`py-1.5 rounded-lg text-xs font-bold transition cursor-pointer ${
                activeTab === "MODES"
                  ? "bg-amber-500 text-zinc-950 shadow-md font-black"
                  : "text-zinc-400 hover:text-zinc-200"
              }`}
            >
              Операции
            </button>
            <button
              onClick={() => {
                triggerHaptic("light");
                setActiveTab("RULES");
              }}
              className={`py-1.5 rounded-lg text-xs font-bold transition cursor-pointer ${
                activeTab === "RULES"
                  ? "bg-amber-500 text-zinc-950 shadow-md font-black"
                  : "text-zinc-400 hover:text-zinc-200"
              }`}
            >
              Справочник
            </button>
            <button
              onClick={() => {
                triggerHaptic("light");
                setActiveTab("SETTINGS");
              }}
              className={`py-1.5 rounded-lg text-xs font-bold transition cursor-pointer ${
                activeTab === "SETTINGS"
                  ? "bg-amber-500 text-zinc-950 shadow-md font-black"
                  : "text-zinc-400 hover:text-zinc-200"
              }`}
            >
              Настройки
