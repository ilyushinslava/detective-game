  // src/App.tsx

  useEffect(() => {
    if (
      !hasStartedEver ||
      isIntroPhase ||
      gameState.winner ||
      gameState.opponent !== "AI"
    ) {
      return;
    }

    const isAITurn = gameState.currentTurn !== gameState.playerRole;

    if (isAITurn) {
