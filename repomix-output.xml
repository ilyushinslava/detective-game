      [createMockChar('3', 'C', true), createMockChar('4', 'D', true)],
    ];
    expect(canCleanupBoard(boardNeedsCleanup)).toBe(true);

    const boardAlreadyClean: Character[][] = [
      [createMockChar('1', 'A', true), createMockChar('2', 'B', true)],
