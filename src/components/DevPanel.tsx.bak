import { useState, useEffect } from "react";
import type { Role } from "../types/game";

export interface DevPanelProps {
  onForceWin: (winner: Role) => void;
  onTriggerInspectorChoice: () => void;
  onResetToMenu: () => void;
  onAddCash: (amount: number) => void;
  onToggleTurn?: () => void;
  onAddKill?: () => void;
  onTriggerIntro?: () => void;
  onTriggerRestartRequest?: () => void;
  onTriggerOpponentLeft?: () => void;
  onTriggerDisguiseModal?: () => void;
  onTriggerCaughtSpyModal?: () => void;
  onClearSession?: () => void;
}

export const DevPanel = ({
  onForceWin,
  onTriggerInspectorChoice,
  onResetToMenu,
  onAddCash,
  onToggleTurn,
  onAddKill,
  onTriggerIntro,
  onTriggerRestartRequest,
  onTriggerOpponentLeft,
  onTriggerDisguiseModal,
  onTriggerCaughtSpyModal,
  onClearSession,
}: DevPanelProps) => {
  if (!import.meta.env.DEV) return null;

  const [isOpen, setIsOpen] = useState(false);

  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.code === "Backquote") {
        setIsOpen((prev) => !prev);
      }
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, []);

  return (
    <>
      <button
        onClick={() => setIsOpen((prev) => !prev)}
        className="fixed top-2 right-14 z-[999] px-2.5 py-1 rounded-full bg-amber-500/30 hover:bg-amber-500/60 border border-amber-500/50 text-[10px] font-mono font-black text-amber-300 backdrop-blur-md shadow-lg transition active:scale-95 cursor-pointer"
        title="DEV панель (~)"
      >
        DEV
      </button>

      {isOpen && (
        <div
          className="fixed inset-0 z-[1000] bg-black/75 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4 select-none"
          onClick={() => setIsOpen(false)}
        >
          <div
            className="w-full max-w-2xl bg-zinc-950 border border-amber-500/50 rounded-3xl p-5 shadow-[0_0_50px_rgba(245,158,11,0.25)] flex flex-col gap-3 font-sans max-h-[90vh] overflow-y-auto custom-scrollbar"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="flex items-center justify-between pb-2 border-b border-white/10">
              <span className="text-xs font-black uppercase tracking-wider text-amber-400">
                ⚡ Dev / QA Control Center
              </span>
              <button
                onClick={() => setIsOpen(false)}
                className="text-zinc-500 hover:text-white text-xs font-bold p-1 cursor-pointer"
              >
                ✕
              </button>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              {/* Секция 1: Матч и Исход */}
              <div className="flex flex-col gap-2 p-3 rounded-2xl bg-zinc-900/40 border border-white/5">
                <span className="text-[10px] font-black uppercase text-red-400 tracking-wider">
                  Матч & Исход
                </span>
                <button
                  onClick={() => { onForceWin("KILLER"); setIsOpen(false); }}
                  className="w-full py-2 px-2.5 bg-red-950/60 hover:bg-red-900/80 border border-red-700/50 rounded-xl text-red-200 text-[11px] font-bold text-left transition cursor-pointer"
                >
                  💀 Победа Бандита
                </button>
                <button
                  onClick={() => { onForceWin("DETECTIVE"); setIsOpen(false); }}
                  className="w-full py-2 px-2.5 bg-cyan-950/60 hover:bg-cyan-900/80 border border-cyan-700/50 rounded-xl text-cyan-200 text-[11px] font-bold text-left transition cursor-pointer"
                >
                  🛡️ Победа Инспектора
                </button>
                {onToggleTurn && (
                  <button
                    onClick={onToggleTurn}
                    className="w-full py-2 px-2.5 bg-zinc-800 hover:bg-zinc-700 border border-white/10 rounded-xl text-zinc-200 text-[11px] font-bold text-left transition cursor-pointer"
                  >
                    🔄 Сменить ход
                  </button>
                )}
                {onAddKill && (
                  <button
                    onClick={onAddKill}
                    className="w-full py-2 px-2.5 bg-zinc-800 hover:bg-zinc-700 border border-white/10 rounded-xl text-zinc-200 text-[11px] font-bold text-left transition cursor-pointer"
                  >
                    🎯 +1 Убийство
                  </button>
                )}
              </div>

              {/* Секция 2: Модалки и Экраны */}
              <div className="flex flex-col gap-2 p-3 rounded-2xl bg-zinc-900/40 border border-white/5">
                <span className="text-[10px] font-black uppercase text-cyan-400 tracking-wider">
                  Модалки & Экраны
                </span>
                <button
                  onClick={() => { onTriggerInspectorChoice(); setIsOpen(false); }}
                  className="w-full py-2 px-2.5 bg-blue-950/60 hover:bg-blue-900/80 border border-blue-700/50 rounded-xl text-blue-200 text-[11px] font-bold text-left transition cursor-pointer"
                >
                  🔍 Выбор инспектора (4к)
                </button>
                {onTriggerIntro && (
                  <button
                    onClick={() => { onTriggerIntro(); setIsOpen(false); }}
                    className="w-full py-2 px-2.5 bg-zinc-800 hover:bg-zinc-700 border border-white/10 rounded-xl text-zinc-200 text-[11px] font-bold text-left transition cursor-pointer"
                  >
                    👁️ Экран интро / ролей
                  </button>
                )}
                {onTriggerRestartRequest && (
                  <button
                    onClick={() => { onTriggerRestartRequest(); setIsOpen(false); }}
                    className="w-full py-2 px-2.5 bg-amber-950/60 hover:bg-amber-900/80 border border-amber-700/50 rounded-xl text-amber-200 text-[11px] font-bold text-left transition cursor-pointer"
                  >
                    🤝 Окно реванша
                  </button>
                )}
                {onTriggerDisguiseModal && (
                  <button
                    onClick={() => { onTriggerDisguiseModal(); setIsOpen(false); }}
                    className="w-full py-2 px-2.5 bg-zinc-800 hover:bg-zinc-700 border border-white/10 rounded-xl text-zinc-200 text-[11px] font-bold text-left transition cursor-pointer"
                  >
                    🎭 Смена лица (Маска)
                  </button>
                )}
                {onTriggerCaughtSpyModal && (
                  <button
                    onClick={() => { onTriggerCaughtSpyModal(); setIsOpen(false); }}
                    className="w-full py-2 px-2.5 bg-zinc-800 hover:bg-zinc-700 border border-white/10 rounded-xl text-zinc-200 text-[11px] font-bold text-left transition cursor-pointer"
                  >
                    🕵️ Раскрытие шпиона
                  </button>
                )}
                {onTriggerOpponentLeft && (
                  <button
                    onClick={() => { onTriggerOpponentLeft(); setIsOpen(false); }}
                    className="w-full py-2 px-2.5 bg-red-950/60 hover:bg-red-900/80 border border-red-700/50 rounded-xl text-red-200 text-[11px] font-bold text-left transition cursor-pointer"
                  >
                    🚪 Уход соперника
                  </button>
                )}
              </div>

              {/* Секция 3: Система и Тесты */}
              <div className="flex flex-col gap-2 p-3 rounded-2xl bg-zinc-900/40 border border-white/5">
                <span className="text-[10px] font-black uppercase text-emerald-400 tracking-wider">
                  Система & Тесты
                </span>
                <button
                  onClick={() => onAddCash(1000)}
                  className="w-full py-2 px-2.5 bg-emerald-950/60 hover:bg-emerald-900/80 border border-emerald-700/50 rounded-xl text-emerald-200 text-[11px] font-bold text-left transition cursor-pointer"
                >
                  💰 +1,000 CR
                </button>
                <button
                  onClick={() => onAddCash(10000)}
                  className="w-full py-2 px-2.5 bg-emerald-950/60 hover:bg-emerald-900/80 border border-emerald-700/50 rounded-xl text-emerald-200 text-[11px] font-bold text-left transition cursor-pointer"
                >
                  💎 +10,000 CR
                </button>
                {onClearSession && (
                  <button
                    onClick={onClearSession}
                    className="w-full py-2 px-2.5 bg-zinc-800 hover:bg-zinc-700 border border-white/10 rounded-xl text-zinc-300 text-[11px] font-bold text-left transition cursor-pointer"
                  >
                    🧹 Сброс сессии + F5
                  </button>
                )}
                <button
                  onClick={() => { onResetToMenu(); setIsOpen(false); }}
                  className="w-full py-2 px-2.5 bg-zinc-900 hover:bg-zinc-800 border border-white/10 rounded-xl text-zinc-300 text-[11px] font-bold text-left transition cursor-pointer"
                >
                  🏠 В главное меню
                </button>
              </div>
            </div>

            <span className="text-[9px] font-mono text-zinc-600 text-center mt-1">
              Нажмите [~] для быстрого переключения
            </span>
          </div>
        </div>
      )}
    </>
  );
};
